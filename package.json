{
  "name": "fiftyfifty",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "generate": "nuxt generate",
    "dev": "nuxt dev",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "bun run lint:fix && bun run lint:format",
    "lint:fix": "eslint . --fix",
    "lint:format": "prettier --loglevel warn --no-error-on-unmatched-pattern --write \"app/**/*.{ts,js,tsx,jsx,vue,css,scss,md,json}\"",
    "typecheck": "nuxt typecheck"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.111",
