{
  "name": "nuxt-template",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "generate": "nuxt generate",
    "dev": "nuxt dev",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "bun run lint:fix && bun run lint:format",
    "lint:fix": "eslint . --fix",
    "lint:format": "prettier --loglevel warn --no-error-on-unmatched-pattern --write \"app/**/*.{ts,js,tsx,jsx,vue,css,scss,md,json}\"",
    "typecheck": "nuxt typecheck",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "test:unit": "vitest --project unit",
    "test:nuxt": "vitest --project nuxt"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.111",
    "@iconify-json/simple-icons": "^1.2.85",
    "@nuxt/test-utils": "4.0.3",
    "@nuxt/ui": "^4.8.2",
    "@nuxtjs/device": "4.0.0",
    "@nuxtjs/google-fonts": "3.2.0",
    "@pinia/nuxt": "0.11.3",
    "@vite-pwa/nuxt": "1.1.1",
    "@vueuse/nuxt": "14.3.0",
    "nuxt": "^4.4.8",
    "pinia": "^3.0.4",
    "tailwindcss": "^4.3.0",
    "vue": "^3.5.35"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.15.2",
    "@types/bun": "^1.3.14",
    "@vitest/coverage-v8": "^4.1.8",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^2.8.8",
    "sass": "^1.72.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8",
    "vue-tsc": "^3.3.3"
  },
  "prettier": {
    "singleQuote": false,
    "arrowParens": "always",
    "endOfLine": "lf",
    "trailingComma": "es5"
  }
}
