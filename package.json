    "@nuxt/ui": "^4.8.2",
    "@nuxtjs/device": "4.0.0",
    "@nuxtjs/google-fonts": "3.2.0",
    "@pinia/nuxt": "0.11.3",
    "@vite-pwa/nuxt": "1.1.1",
    "@vueuse/motion": "^3.0.3",
    "@vueuse/nuxt": "14.3.0",
    "idb": "^8.0.3",
    "nuxt": "^4.4.8",
    "pinia": "^3.0.4",
    "tailwindcss": "^4.3.0",
    "vue": "^3.5.35"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.15.2",
    "@types/bun": "^1.3.14",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^2.8.8",
    "sass": "^1.72.0",
    "typescript": "^6.0.3",
    "vue-tsc": "^3.3.3"
  },
  "prettier": {
    "singleQuote": false,
